rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin' &&
        (request.auth.token.adminId == 'nikhilasc' ||
         request.auth.token.adminId == 'kailashasc');
    }

    function isCustomer() {
      return signedIn() && request.auth.token.role == 'customer' &&
        request.auth.token.customerId != null;
    }

    function myCustomerId() {
      return request.auth.token.customerId;
    }

    match /userProfiles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin() ||
        (isCustomer() && customerId == myCustomerId());
      allow create, update, delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin() ||
        (isCustomer() && resource.data.customerId == myCustomerId());
      allow create, update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() ||
        (isCustomer() && resource.data.customerId == myCustomerId());
      allow create, update, delete: if isAdmin();
    }

    match /inventory/{id} {
      allow read, write: if isAdmin();
    }
    match /purchases/{id} {
      allow read, write: if isAdmin();
    }
    match /traderPayments/{id} {
      allow read, write: if isAdmin();
    }
    match /cashbook/{id} {
      allow read, write: if isAdmin();
    }
    match /returns/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
